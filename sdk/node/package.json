{
  "name": "@hostmk/security-sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK for HostMK Security Framework",
  "author": "HostMK",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/azezaz/HostMK-Security-Framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azezaz/HostMK-Security-Framework.git"
  },
  "bugs": {
    "url": "https://github.com/azezaz/HostMK-Security-Framework/issues"
  },
  "keywords": [
    "hostmk",
    "security",
    "rbac",
    "audit",
    "fraud",
    "tenancy",
    "permissions",
    "sdk"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup src/index.ts --format esm,cjs --dts",
    "dev": "vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.39.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}